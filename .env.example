# AI panel backend config. Copy to `.env` and fill in only what you override.
# Every var here is optional — blank falls back to the shared dev server on
# torta-server, which is what most people want.
#
# Production builds do not read this file: .env.production pins
# VITE_BACKEND_URL for `npm run build`, so a local override here can never be
# deployed by accident. Use `.env.local` for machine-specific values you do not
# want committed.

# Set this only when running k12-llm-backend yourself, e.g.
# http://localhost:3000. Blank means https://k12api.torta-server.duckdns.org.
#
# Google sign-in goes straight from the browser to this backend and back —
# there is no dev proxy — so whichever backend you point at must have your dev
# origin (http://localhost:5173) in its ALLOWED_ORIGINS, and its
# GOOGLE_REDIRECT_URI registered on the Google OAuth client.
VITE_BACKEND_URL=

VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
