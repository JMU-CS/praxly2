// ===========================================================================
// Praxly2 feature demo -- PRAXIS        (shared notes: examples/README.md)
// ---------------------------------------------------------------------------
// Praxis maps most directly to the Universal AST, so it reaches the widest
// set of nodes.
//
// AST nodes NOT reachable from Praxis source (covered by the other demos):
//   Constructor .......... Praxis has no constructor syntax; use field
//                          initializers (see class bodies below).
//   Switch / SwitchCase .. no switch/case keywords.
//   Try / ExceptionHandler no try/catch keywords.
//   Break / Continue ..... no break/continue keywords.
//   ConditionalExpression  no ?: ternary operator.
//   CompoundAssignment ... no +=/-=; write `x <- x + 1`.
//   ListComprehension .... Python-only.
//
// (Functions and classes are hoisted, so the driver calls them before their
// declarations appear further down the file.)
// ===========================================================================


// ========================== EXPRESSIONS ====================================
banner("literals and operators")

// ---- Literal (int, float, string, boolean, null) + Assignment --------------
int    whole  <- 42
double frac   <- 3.14
string label  <- "praxis"
boolean flag  <- true
string empty  <- null
print(whole, frac, label, flag, empty)   // Print with multiple expressions

// `=` is also a valid assignment operator in Praxis (same as `<-`)
int m <- 0
m = 10
print(m)

// ---- BinaryExpression: arithmetic (+ - * / % mod ^) ------------------------
int a <- 17
int b <- 5
print(a + b)      // 22
print(a - b)      // 12
print(a * b)      // 85
print(a / b)      // 3   (integer division: both operands are int)
print(a % b)      // 2
print(a mod b)    // 2   (`mod` keyword == `%`)
print(2 ^ 10)     // 1024 (exponent, right-associative)

// ---- UnaryExpression (- and not) -------------------------------------------
print(-a)         // -17
print(not flag)   // false

// ---- BinaryExpression: comparison + logical (and/or) + unicode forms -------
print(a > b and b > 0)   // true
print(a == 17)           // true
print(a != b)            // true
print(a <> b)            // true (<> alias for !=)
print(b <= a)            // true
print(b ≤ a)             // true (unicode ≤)
print(a ≠ b)             // true (unicode ≠)
print(a < b or a > b)    // true

// ---- UpdateExpression (++ and --, prefix and postfix) ----------------------
int i <- 5
i++
print(i)      // 6
print(++i)    // 7
i--
print(i)      // 6

// ---- ArrayLiteral / IndexExpression / MemberExpression / CallExpression ----
int[] xs <- {5, 3, 8, 1}    // brace form (idiomatic); [5, 3, 8, 1] also works
xs[0] <- 50                 // index Assignment
print(xs[0])                // 50
print(xs.length)            // 4  (MemberExpression)
xs.append(99)               // method CallExpression as ExpressionStatement
print(xs.length)            // 5
print(xs)                   // {50, 3, 8, 1, 99}

// ---- Print: separator / appendLineFeed via trailing comment ----------------
print("A", "B", "C")           // "A B C"  (default separator " ")
print("X", "Y") // no separator // "XY"
print("joined: ") // no line feed
print("tail")                  // -> "joined: tail" on one line


// ========================== STATEMENTS =====================================
banner("control flow")

// ---- If / else with a nested If (Praxis has no `else if`) ------------------
int score <- 75
if (score >= 90)
    print("A")
else
    if (score >= 70)
        print("B")             // this runs
    else
        print("C")
    end if
end if

// ---- While (pre-condition loop) --------------------------------------------
int w <- 0
while (w < 3)
    print(w)                   // 0 1 2
    w <- w + 1
end while

// ---- For, C-style (init / condition / update) ------------------------------
int total <- 0
for j <- 0; j < xs.length; j <- j + 1
    total <- total + xs[j]
end for
print(total)                   // 161

// ---- For, for-each over an array -------------------------------------------
for x in xs
    print(x)
end for

// ---- For, for-each over range() --------------------------------------------
for k in range(1, 4)
    print(k)                   // 1 2 3
end for

// ---- DoWhile (post-condition; repeats WHILE the condition is true) ---------
int d <- 0
do
    print(d)                   // 0 1 2
    d <- d + 1
while (d < 3)

// ---- RepeatUntil (post-condition; repeats UNTIL the condition is true) -----
int r <- 0
repeat
    print(r)                   // 0 1 2
    r <- r + 1
until (r >= 3)


// ========================== FUNCTIONS ======================================
banner("functions and objects")

// ---- FunctionDeclaration / Parameter / Return (with and without a value) ---
int add(int a, int b)
    return a + b               // Return with a value
end add

int fact(int n)
    if (n <= 1)
        return 1
    else
        return n * fact(n - 1) // recursion via CallExpression
    end if
end fact

// `procedure` keyword => a void FunctionDeclaration
procedure banner(string text)
    print("== " + text + " ==")
end banner

procedure maybePrint(boolean show)
    if (not show)
        return                 // bare Return (Return.value omitted)
    end if
    print("shown")
end maybePrint

// ---- Calls, recursion, void procedures -------------------------------------
print(add(3, 4))      // 7
print(fact(5))        // 120
maybePrint(false)     // (prints nothing)
maybePrint(true)      // shown


// ========================== CLASSES ========================================

// ---- ClassDeclaration / FieldDeclaration / MethodDeclaration ---------------
class Counter
    public int count <- 0      // public FieldDeclaration with initializer
    private int step <- 1      // private FieldDeclaration with initializer

    void increment()
        this.count <- this.count + this.step   // member Assignment via `this`
    end increment

    int getCount()
        return this.count
    end getCount
end class

class Animal
    public string name <- "animal"
    private int legs <- 4
    string tag                 // bare field => declaredWithoutInitializer

    void setTag(string t)
        this.tag <- t
    end setTag

    string kind()
        return "living thing"  // field-free method (safe to inherit)
    end kind

    string describe()
        return this.name + " (" + this.tag + ") has " + str(this.legs) + " legs"
    end describe
end class

// ClassDeclaration.superClass via `extends`. Dog inherits every Animal member
// (the name/legs/tag fields plus setTag/kind/describe) and adds its own
// speak(). Both inherited method dispatch AND inherited field access work
// (see dog.describe() below).
class Dog extends Animal
    string speak()
        return "woof"
    end speak
end class

// ---- NewExpression / methods / fields / inheritance ------------------------
Counter c <- new Counter()
c.increment()
c.increment()
print(c.getCount())   // 2

Animal pet <- new Animal()
pet.setTag("pet")
print(pet.describe()) // animal (pet) has 4 legs

Dog dog <- new Dog()
dog.setTag("puppy")   // inherited setter mutates this instance
print(dog.speak())    // woof (Dog's own method)
print(dog.kind())     // living thing (method inherited from Animal)
print(dog.describe()) // animal (puppy) has 4 legs (inherited fields + method)

banner("done")
