# Committed on purpose: no secrets here, just the public backend origin the
# production bundle should talk to.
#
# deploy.sh runs `npm run build` on a developer's machine, which inlines
# whatever VITE_* values are in scope at build time. Without this file, a
# developer with VITE_BACKEND_URL=http://localhost:3000 in their .env (normal
# while working against a local backend) would ship a production bundle
# pointing at localhost. Vite loads .env.production only for `vite build`, and
# it outranks .env, so the deployed bundle is pinned regardless of local state.
#
# Use .env.local for local overrides — it is gitignored and never applies to a
# production build.
#
# torta-server is the temporary backend host; revisit when the real backend
# server is provisioned.
VITE_BACKEND_URL=https://k12api.torta-server.duckdns.org
